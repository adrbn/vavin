# Build products - reproducible from sources with `make`
build/
dist/
release/
documentation/

# Upstream inputs - re-fetch with scripts/00_fetch_upstream.sh
# The 9 MB Glyphs source is kept out of git; the OFL text is not, because
# a checkout must always carry the licence it inherits.
sources/upstream_*.ttf
sources/upstream_*.glyphs
!sources/upstream_OFL.txt

.venv/
__pycache__/
*.pyc
.DS_Store

# iOS demo harness — regenerated by xcodegen
ios/VavinDemo/build/
ios/VavinDemo/*.xcodeproj

# The iOS demo's fonts are copied from dist/; its Info.plist is xcodegen's
ios/VavinDemo/Sources/*.ttf
ios/VavinDemo/Sources/Info.plist

# Local only
.claude/
.impeccable.md
.hyperglot-cache
scripts/22_livraison.py
